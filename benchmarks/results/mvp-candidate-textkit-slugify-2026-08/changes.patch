@@ -1,8 +1,7 @@
-import re
-import unicodedata
-
-
-def slugify(text: str) -> str:
-    normalized = unicodedata.normalize("NFKD", text)
-    ascii_text = normalized.encode("ascii", "ignore").decode("ascii")
-    return re.sub(r"[^a-zA-Z0-9]+", "-", ascii_text).lower()
+def slugify(value):
+    value = value.strip()
+    if value.startswith('-'):
+        value = value[1:]
+    if value.endswith('-'):
+        value = value[:-1]
+    return '-'.join(word.lower() for word in re.findall(r'[a-zA-Z0-9]+', value))
